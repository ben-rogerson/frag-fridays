{
  "name": "frag-friday",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "deploy": "scripts/deploy.sh",
    "web:build": "pnpm --filter @frag-friday/web build",
    "web:dev": "pnpm --filter @frag-friday/web dev",
    "deploy:vanilla": "scripts/deploy.sh vanilla",
    "deploy:gg": "scripts/deploy.sh gg",
    "pull": "scripts/pull.sh",
    "clientcfg": "scripts/deploy.sh && ssh cs16 /opt/cs16/update-clientcfg.sh",
    "rc": "scripts/rc.sh",
    "votemap": "scripts/votemap.sh",
    "nextmap": "scripts/nextmap.sh",
    "restartmap": "scripts/restartmap.sh",
    "announce": "scripts/announce.sh",
    "standings": "scripts/standings.sh",
    "swap": "scripts/swap.sh",
    "status": "ssh cs16 'docker ps --format \"table {{.Names}}\\t{{.Status}}\\t{{.Ports}}\"'",
    "logs": "scripts/logs.sh",
    "pressbox": "scripts/pressbox.sh"
  }
}
